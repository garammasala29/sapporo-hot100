#!/usr/bin/env ruby
# frozen_string_literal: true

require 'net/http'
require 'json'
require 'base64'
require 'securerandom'
require 'uri'

env_file = File.expand_path('../.env', __dir__)
if File.exist?(env_file)
  require 'dotenv'
  Dotenv.load(env_file)
end

REDIRECT_URI = 'https://127.0.0.1:3000/auth/spotify/callback'
REQUEST_TIMEOUT = 15

# Spotify no longer allows plain HTTP redirect URIs (including localhost/127.0.0.1) for
# new authorizations, so this uses a dummy HTTPS redirect URI that is never actually
# served. After granting access, Spotify redirects the browser to that unreachable URL;
# the authorization code is still visible in the browser's address bar and is copied
# from there manually. See the Redirect URIs of the app at
# https://developer.spotify.com/dashboard — REDIRECT_URI above must be registered there.
def fetch_env(name)
  ENV[name] or abort "Error: #{name} environment variable is required."
end

def post_form(uri, headers, form)
  http = Net::HTTP.new(uri.host, uri.port)
  http.use_ssl = true
  http.open_timeout = REQUEST_TIMEOUT
  http.read_timeout = REQUEST_TIMEOUT

  request = Net::HTTP::Post.new(uri)
  headers.each { |k, v| request[k] = v }
  request.body = URI.encode_www_form(form)

  response = http.request(request)
  JSON.parse(response.body)
end

def exchange_code_for_tokens(code, client_id, client_secret)
  uri = URI('https://accounts.spotify.com/api/token')
  headers = {
    'Authorization' => "Basic #{Base64.strict_encode64("#{client_id}:#{client_secret}")}",
    'Content-Type' => 'application/x-www-form-urlencoded'
  }
  form = { grant_type: 'authorization_code', code: code, redirect_uri: REDIRECT_URI }

  data = post_form(uri, headers, form)
  data['access_token'] or raise "Failed to exchange code: #{data['error_description'] || data['error']}"
  data
end

def fetch_user_id(access_token)
  uri = URI('https://api.spotify.com/v1/me')
  http = Net::HTTP.new(uri.host, uri.port)
  http.use_ssl = true
  http.open_timeout = REQUEST_TIMEOUT
  http.read_timeout = REQUEST_TIMEOUT

  request = Net::HTTP::Get.new(uri)
  request['Authorization'] = "Bearer #{access_token}"

  response = http.request(request)
  JSON.parse(response.body)['id']
end

def set_github_secret(name, value)
  # Passed via stdin (not command-line/shell interpolation) so the secret value
  # never touches shell history or a process listing.
  require 'open3'
  Open3.capture3('gh', 'secret', 'set', name, stdin_data: value)
end

def main
  client_id = fetch_env('CLIENT_ID')
  client_secret = fetch_env('CLIENT_SECRET')
  state = SecureRandom.hex(16)

  authorize_url = 'https://accounts.spotify.com/authorize?' + URI.encode_www_form(
    client_id: client_id,
    response_type: 'code',
    redirect_uri: REDIRECT_URI,
    scope: 'playlist-modify-public',
    state: state
  )

  puts 'Open this URL in a browser, log in, and grant access:'
  puts authorize_url
  puts
  puts 'After granting access, the browser will land on a page that fails to load'
  puts "(#{REDIRECT_URI} is not a real server). That's expected."
  puts 'Copy the full URL from the address bar and paste it here:'
  print '> '
  redirected_url = gets&.strip
  abort 'No URL provided.' if redirected_url.nil? || redirected_url.empty?

  params = URI.decode_www_form(URI(redirected_url).query.to_s).to_h
  abort "State mismatch (got #{params['state'].inspect}, expected #{state.inspect}). Aborting." if params['state'] != state
  code = params['code']
  abort "No 'code' parameter found in the pasted URL." unless code

  puts 'Exchanging code for tokens...'
  tokens = exchange_code_for_tokens(code, client_id, client_secret)
  user_id = fetch_user_id(tokens['access_token'])

  puts
  puts 'Success. New credentials:'
  puts "  SPOTIFY_REFRESH_TOKEN=#{tokens['refresh_token']}"
  puts "  SPOTIFY_USER_ID=#{user_id}"
  puts

  print 'Update these in GitHub Secrets now with `gh secret set`? [y/N] '
  answer = gets&.strip&.downcase
  if answer == 'y'
    set_github_secret('SPOTIFY_REFRESH_TOKEN', tokens['refresh_token'])
    set_github_secret('SPOTIFY_USER_ID', user_id)
    puts 'GitHub Secrets updated.'
  else
    puts 'Skipped. Set them manually if needed:'
    puts "  gh secret set SPOTIFY_REFRESH_TOKEN"
    puts "  gh secret set SPOTIFY_USER_ID"
  end
end

main
